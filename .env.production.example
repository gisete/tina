# Variable NAMES only. Copy to .env.production on the server and fill in values.
# .env.production is git-ignored; never commit values.

# --- db service (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- app ---
# Host must be "db:5432" inside the compose network.
DATABASE_URL=

# Auth.js (NextAuth v5)
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Health API token refresh (src/lib/google/client.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
SYNC_DEBUG=
